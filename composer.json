{
    "name": "reinfyteam/libvapm-pmmp",
    "keywords": ["vapm-pmmp", "asynchronous", "LibVapmPMMP", "lib-vapm-pmmp", "process", "thread"],
    "license": "LGPL-2.0-only",
    "type": "project",
    "version": "2.5.8",
    "autoload": {
        "psr-4": {
            "vennv\\vapm\\": "src/vennv/vapm/"
        }
    },
    "authors": [
        {
            "name": "VennDev",
            "email": "1050080275@sv.hcmunre.edu.vn"
        }
    ],
    "config": {
    	"allow-plugins": {
    		"phpstan/extension-installer": true
    	}
    },
    "require-dev": {
        "php-64bit": "*",
    	"composer-runtime-api": "^2.0",
        "pocketmine/pocketmine-mp": "^5.17.0",
        "php": ">=8.2",
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "^3.94.2"
    },
    "scripts": {
        "analyse-src": "./vendor/bin/phpstan analyse -c phpstan.neon.dist",
        "compat-api5": "php tests/compat_api5.php",
        "benchmark-queue": "php tests/stress_queue.php 500",
        "benchmark-mixed": "php tests/mixed_scheduler.php 200 50 50",
        "benchmark-compare": [
            "@benchmark-queue",
            "@benchmark-mixed"
        ],
		"build": "php -dphar.readonly=0 tools/build.php"
    }
}
